# Copy this file to `.env` and fill in your keys.
# The app runs fine without them (it degrades gracefully), but you'll get
# real data only once the relevant keys are set.

# --- LLM (Groq free tier) ---
GROQ_API_KEY=
# Optional second key: used automatically as failover if the primary errors.
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama fallback (only used when GROQ_API_KEY is unset; offline dev) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Duffel (flights + hotels). Test token starts with "duffel_test_" ---
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# --- OpenTripMap (points of interest / activities) ---
OPENTRIPMAP_API_KEY=

# --- OpenWeather (Current Weather + 5-day forecast, free tier) ---
OPENWEATHER_API_KEY=

# --- LangSmith tracing (optional; set LANGCHAIN_TRACING_V2=true to enable) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-assistant-hackathon